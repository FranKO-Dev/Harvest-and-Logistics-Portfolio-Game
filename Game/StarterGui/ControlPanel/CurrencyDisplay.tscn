[gd_scene format=3 uid="uid://ckcosal3jvjc7"]

[sub_resource type="GDScript" id="GDScript_fuqhk"]
resource_name = "CurrencyDisplay"
script/source = "extends Control

@onready var coins_label = $MarginContainer/HBoxContainer/Coins/Label
@onready var bills_label = $MarginContainer/HBoxContainer/Bills/Label

@export var player: Player

func _ready() -> void:
	coins_label.text = \"Coins \" + var_to_str(player.get_currency(\"coins\"))
	bills_label.text = \"Bills \" + var_to_str(player.get_currency(\"bills\"))
	player.currency_changed.connect(_currency_changed)
	

func _currency_changed(currency_id: String, _previous: int, current: int):
	var label_target: Label
	match currency_id:
		\"coins\":
			label_target = coins_label;
		\"bills\":
			label_target = bills_label;
		
	label_target.text = currency_id.capitalize() + var_to_str(current)
	
"

